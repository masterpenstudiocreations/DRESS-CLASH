+  const key = hex + amt;
+  const hit = cache.get(key);
+  if (hit) return hit;
+  const [r, g, b] = parse(hex);
+  const t = amt < 0 ? 0 : 255;
+  const k = Math.abs(amt);
+  const out = `rgb(${Math.round(r + (t - r) * k)},${Math.round(g + (t - g) * k)},${Math.round(b + (t - b) * k)})`;
